             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    <persistence-unit name="entityManager">
        <class>app.adapters.out.persistence.entity.ParticipanteJpaEntity</class>
        <class>app.adapters.out.persistence.entity.MentorJpaEntity</class>
        <class>app.adapters.out.persistence.entity.MentoradoJpaEntity</class>
